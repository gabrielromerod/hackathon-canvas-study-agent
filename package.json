{
  "name": "canvas-study-agent",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "package": "npm run build && npm run check && node scripts/package.mjs",
    "preview": "node scripts/preview.mjs",
    "format": "prettier --write \"src/**/*.js\" \"public/*.{json,html,css}\" \"scripts/*.mjs\" \"tests/**/*.js\" \"tests/fixtures/preview-course.json\" \"demo/*.{js,html,css}\" package.json",
    "format:check": "prettier --check \"src/**/*.js\" \"public/*.{json,html,css}\" \"scripts/*.mjs\" \"tests/**/*.js\" \"tests/fixtures/preview-course.json\" \"demo/*.{js,html,css}\" package.json",
    "demo:build": "node scripts/portfolio.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "dependencies": {
    "@huggingface/jinja": "0.5.10",
    "@huggingface/tokenizers": "0.2.0",
    "@litert-lm/core": "0.18.0",
    "@noble/hashes": "2.0.1",
    "@phosphor-icons/core": "^2.1.1",
    "dompurify": "3.4.17",
    "idb": "^8.0.4",
    "katex": "0.19.0",
    "marked": "18.1.1"
  }
}
